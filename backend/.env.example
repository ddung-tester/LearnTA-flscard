# Copy thành backend/.env khi chạy local. Không commit file .env.
# Production: các biến này đặt trên Render (xem render.yaml và docs/deploy-render-supabase.md).

# CSDL Postgres — cách 1: chuỗi kết nối (Supabase → Connect → Session pooler)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
DB_SSL=true
# Cách 2: Postgres local (để trống DATABASE_URL)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=flashcard_db

PORT=8080
JWT_SECRET=<chuoi-ngau-nhien-dai>
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GEMINI_API_KEY=<gemini-api-key>
# Nhiều origin cách nhau bằng dấu phẩy. Production phải có https://dungdinh.vercel.app
CORS_ORIGIN=http://localhost:5173

# Audio khoá học (Supabase Storage, bucket private). Secret key chỉ để ở server.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<sb_secret_...>
COURSE_AUDIO_BUCKET=course-audio

# Chỉ dùng cho script chuyen-du-lieu-mysql.js (nguồn MySQL cũ)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=flashcard_db
