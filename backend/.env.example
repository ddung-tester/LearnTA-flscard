# Copy thành backend/.env khi chạy local. Không commit file .env.

# CSDL Postgres — cách 1: chuỗi kết nối (Supabase → Connect → Session pooler)
DATABASE_URL=
DB_SSL=true
# Cách 2: Postgres local (để trống DATABASE_URL)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=flashcard_db

PORT=8080
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
CORS_ORIGIN=http://localhost:5173

# Audio khoá học (Supabase Storage, bucket private)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
COURSE_AUDIO_BUCKET=course-audio

# Chỉ dùng cho script chuyen-du-lieu-mysql.js (nguồn MySQL cũ)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=flashcard_db
