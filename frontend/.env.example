# Local frontend -> Railway backend
# Copy to .env.local when running `npm run dev` locally.
VITE_API_BASE_URL=https://your-backend-service.up.railway.app

# If you run backend locally instead, use:
# VITE_API_BASE_URL=http://localhost:3000

# Google OAuth Client ID (lấy từ Google Cloud Console > APIs & Services > Credentials)
# Phải khớp với GOOGLE_CLIENT_ID trong backend .env
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
